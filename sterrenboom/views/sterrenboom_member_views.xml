<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sterrenboom_member_view_list" model="ir.ui.view">
        <field name="name">sterrenboom.member.list</field>
        <field name="model">sterrenboom.member</field>
        <field name="arch" type="xml">
            <list string="Committee Members">
                <field name="name"/>
                <field name="role"/>
                <field name="email"/>
                <field name="phone" optional="show"/>
                <field name="event_count" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sterrenboom_member_view_form" model="ir.ui.view">
        <field name="name">sterrenboom.member.form</field>
        <field name="model">sterrenboom.member</field>
        <field name="arch" type="xml">
            <form string="Committee Member">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Jan Janssens"/></h1>
                    </div>
                    <group>
                        <group string="Committee">
                            <field name="role"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Contact">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Events" name="events">
                            <field name="event_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="location"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sterrenboom_member_view_search" model="ir.ui.view">
        <field name="name">sterrenboom.member.search</field>
        <field name="model">sterrenboom.member</field>
        <field name="arch" type="xml">
            <search string="Committee Members">
                <field name="name"/>
                <field name="email"/>
                <field name="role"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_role" string="Role" context="{'group_by': 'role'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sterrenboom_member_action" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">sterrenboom.member</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sterrenboom_member_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first committee member
            </p>
            <p>
                Keep track of who sits on the parent committee, their role and contact details.
            </p>
        </field>
    </record>

</odoo>
