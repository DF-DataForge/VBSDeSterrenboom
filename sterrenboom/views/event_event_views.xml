<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="event_event_view_form_inherit_sterrenboom" model="ir.ui.view">
        <field name="name">event.event.view.form.inherit.sterrenboom</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='right_event_details']/field[@name='address_id']"
                   position="after">
                <field name="sterrenboom_page_view_id"
                       options="{'no_create': True, 'no_quick_create': True}"
                       groups="event.group_event_manager"/>
                <field name="sterrenboom_header_image" widget="image"
                       options="{'size': [240, 0]}"
                       groups="event.group_event_manager"/>
            </xpath>
        </field>
    </record>

</odoo>
