<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form_inherit_sterrenboom" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.sterrenboom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@id='create_invoice']" position="before">
                <button name="action_sterrenboom_send_tickets"
                        string="Send Tickets"
                        type="object"
                        class="btn-primary"
                        invisible="attendee_count == 0 or state != 'sale'"
                        confirm="The attendees will be registered and mailed their tickets (again, if they were sent before). Only do this once the bank transfer has been processed. Continue?"/>
            </xpath>
            <xpath expr="//page[@name='other_information']//group[@name='sale_info']" position="inside">
                <field name="sterrenboom_tickets_on_hold" readonly="1"
                       invisible="not sterrenboom_tickets_on_hold"/>
                <field name="sterrenboom_tickets_sent_date"
                       invisible="not sterrenboom_tickets_sent_date"/>
            </xpath>
        </field>
    </record>

</odoo>
