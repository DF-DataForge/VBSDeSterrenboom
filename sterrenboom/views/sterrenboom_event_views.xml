<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sterrenboom_event_view_list" model="ir.ui.view">
        <field name="name">sterrenboom.event.list</field>
        <field name="model">sterrenboom.event</field>
        <field name="arch" type="xml">
            <list string="Committee Events" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="date_end" optional="hide"/>
                <field name="location" optional="show"/>
                <field name="attendee_count" string="Attendees"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-info="state == 'ongoing'"
                       decoration-warning="state == 'planned'"/>
            </list>
        </field>
    </record>

    <record id="sterrenboom_event_view_form" model="ir.ui.view">
        <field name="name">sterrenboom.event.form</field>
        <field name="model">sterrenboom.event</field>
        <field name="arch" type="xml">
            <form string="Committee Event">
                <header>
                    <button name="action_set_ongoing" string="Start" type="object"
                            class="oe_highlight" invisible="state != 'planned'"/>
                    <button name="action_set_completed" string="Mark Completed" type="object"
                            class="oe_highlight" invisible="state != 'ongoing'"/>
                    <button name="action_set_cancelled" string="Cancel" type="object"
                            invisible="state in ('completed', 'cancelled')"/>
                    <button name="action_reset_to_planned" string="Reset to Planned" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planned,ongoing,completed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Schoolfeest 2026"/></h1>
                    </div>
                    <group>
                        <group string="Schedule">
                            <field name="date"/>
                            <field name="date_end"/>
                        </group>
                        <group string="Details">
                            <field name="location"/>
                            <field name="attendee_count"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="What is this event about?"/>
                        </page>
                        <page string="Attendees" name="attendees">
                            <field name="member_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </page>
                        <page string="Internal Notes" name="notes">
                            <field name="notes" placeholder="Notes for the committee only."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="sterrenboom_event_view_calendar" model="ir.ui.view">
        <field name="name">sterrenboom.event.calendar</field>
        <field name="model">sterrenboom.event</field>
        <field name="arch" type="xml">
            <calendar string="Committee Events" date_start="date" date_stop="date_end"
                      mode="month">
                <field name="name"/>
                <field name="location"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="sterrenboom_event_view_search" model="ir.ui.view">
        <field name="name">sterrenboom.event.search</field>
        <field name="model">sterrenboom.event</field>
        <field name="arch" type="xml">
            <search string="Committee Events">
                <field name="name"/>
                <field name="location"/>
                <field name="member_ids"/>
                <filter name="filter_upcoming" string="Upcoming"
                        domain="[('date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="filter_planned" string="Planned"
                        domain="[('state', '=', 'planned')]"/>
                <filter name="filter_open" string="Not Cancelled"
                        domain="[('state', '!=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_date" string="Start Date"
                            context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sterrenboom_event_action" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">sterrenboom.event</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="sterrenboom_event_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Plan your first committee event
            </p>
            <p>
                Track meetings and activities, who attends them, and how far along they are.
            </p>
        </field>
    </record>

</odoo>
