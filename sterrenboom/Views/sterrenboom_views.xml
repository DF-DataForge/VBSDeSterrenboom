<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sterrenboom Member Views -->
        <record id="sterrenboom_member_form" model="ir.ui.view">
            <field name="name">sterrenboom.member.form</field>
            <field name="model">sterrenboom.member</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="role"/>
                            </group>
                            <group>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="active"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="sterrenboom_member_tree" model="ir.ui.view">
            <field name="name">sterrenboom.member.tree</field>
            <field name="model">sterrenboom.member</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="role"/>
                    <field name="email"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="sterrenboom_member_action" model="ir.actions.act_window">
            <field name="name">Members</field>
            <field name="res_model">sterrenboom.member</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Sterrenboom Event Views -->
        <record id="sterrenboom_event_form" model="ir.ui.view">
            <field name="name">sterrenboom.event.form</field>
            <field name="model">sterrenboom.event</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar" options="{'clickable': True}"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="date"/>
                            </group>
                            <group>
                                <field name="location"/>
                                <field name="state" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description" nolabel="1"/>
                            </page>
                            <page string="Attendees">
                                <field name="member_ids" nolabel="1"/>
                            </page>
                            <page string="Notes">
                                <field name="notes" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="sterrenboom_event_tree" model="ir.ui.view">
            <field name="name">sterrenboom.event.tree</field>
            <field name="model">sterrenboom.event</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="location"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="sterrenboom_event_action" model="ir.actions.act_window">
            <field name="name">Events</field>
            <field name="res_model">sterrenboom.event</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Menu Items -->
        <menuitem id="sterrenboom_menu_root" name="Sterrenboom" sequence="10"/>
        <menuitem id="sterrenboom_menu_members" name="Members" parent="sterrenboom_menu_root" 
                  action="sterrenboom_member_action" sequence="1"/>
        <menuitem id="sterrenboom_menu_events" name="Events" parent="sterrenboom_menu_root" 
                  action="sterrenboom_event_action" sequence="2"/>
    </data>
</odoo>
