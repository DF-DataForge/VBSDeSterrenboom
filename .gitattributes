# Normalise line endings so Windows checkouts don't push CRLF to the Linux server.
* text=auto eol=lf

*.py    text eol=lf diff=python
*.xml   text eol=lf
*.csv   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.conf  text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  text eol=lf
*.ico  binary
*.pdf  binary

# Keep generated/vendored assets out of language stats and diffs
sterrenboom/static/description/** linguist-documentation
